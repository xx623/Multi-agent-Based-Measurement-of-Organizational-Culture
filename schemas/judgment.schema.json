{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judgment.schema.json",
  "title": "Judge claims (J1, J2)",
  "type": "object",
  "properties": {
    "passage_id": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "Collaboration and people-focused",
              "Customer-oriented",
              "Innovation and adaptability",
              "Integrity and risk management",
              "Performance-oriented",
              "Other reported norms"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "partially supported",
              "insufficient evidence"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "conduct": {
            "type": "string",
            "minLength": 1
          },
          "content_type": {
            "type": "string",
            "enum": [
              "expectation",
              "rule",
              "routine",
              "episode"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "required",
              "encouraged",
              "permitted",
              "discouraged",
              "sanctioned",
              "unclear"
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "internal",
              "external",
              "unstated"
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "organization-wide",
                  "unit or function",
                  "team or role",
                  "unspecified"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "extent": {
                "type": "string",
                "enum": [
                  "one",
                  "some",
                  "all",
                  "named",
                  "unspecified"
                ]
              }
            },
            "required": [
              "type",
              "target",
              "extent"
            ],
            "additionalProperties": false
          },
          "conduct_status": {
            "type": "string",
            "enum": [
              "completed",
              "ongoing",
              "planned"
            ]
          },
          "generalized_from_event": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "category",
          "status",
          "evidence_ids",
          "conduct",
          "content_type",
          "direction",
          "origin",
          "scope",
          "conduct_status",
          "generalized_from_event"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "completeness_uncertain_affects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "strongest_objection": {
      "type": "string",
      "minLength": 1
    },
    "objection_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objection_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "narrow",
              "defend"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "objection_id",
          "action",
          "evidence_ids",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "passage_id",
    "round",
    "claims",
    "completeness_uncertain_affects",
    "strongest_objection",
    "objection_responses"
  ],
  "additionalProperties": false
}
